{
  "name": "retro-mage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "test:demo:e2e": "playwright test -c playwright.config.ts",
    "test:demo:persistence:proof": "rm -rf examples/demo/node_modules/.vite && pnpm --filter engine-core build && pnpm --filter render build && pnpm --filter demo build && playwright test -c playwright.persistence.config.ts",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
